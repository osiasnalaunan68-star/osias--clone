rules_version = '2';

// Firestore rules para sa CuBLE app.
// Ang user ay hindi pwedeng mag-edit ng sarili niyang subscriptions, appAccess,
// appAccessHistory, paymentHistory, bonuses, isAdmin, o i-reset ang trial.
// Admin lang (isAdmin == true) ang pwede.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Trial: isang beses lang, oras ng server ang startedAt, at 3 days lang
    // (dapat tugma sa TRIAL_DAYS sa src/access.js).
    function trialOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !('trial' in changed)
        || (!('trial' in resource.data)
            && request.resource.data.trial.startedAt == request.time
            && request.resource.data.trial.days == 3);
    }

    // RA 10863 (CL) trial: isang beses lang, oras ng server, 3 days lang
    // (dapat tugma sa CL_TRIAL_DAYS sa src/access.js). Ang mga lumang user na
    // may 7-day clTrial na ay hindi apektado (existing field, hindi na nire-write).
    function clTrialOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !('clTrial' in changed)
        || (!('clTrial' in resource.data)
            && request.resource.data.clTrial.startedAt == request.time
            && request.resource.data.clTrial.days == 3);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('isAdmin', false) == false
        && !('appAccess' in request.resource.data)
        && !('appAccessHistory' in request.resource.data)
        && !('paymentHistory' in request.resource.data)
        && !('bonuses' in request.resource.data)
        && !('trial' in request.resource.data)
        && !('clTrial' in request.resource.data)
        && (!('subscriptions' in request.resource.data)
            || request.resource.data.subscriptions.values().hasOnly([false]));

      // Allowlist: ang user ay makaka-update LANG ng mga field sa baba.
      // Hindi kasama ang subscriptions, appAccess, appAccessHistory,
      // paymentHistory, bonuses, isAdmin — admin lang ang pwede doon.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'devices', 'fullName', 'displayName', 'photoURL', 'email',
                 'pendingPurchases', 'pendingAccess', 'lastSeenAt', 'trial', 'clTrial'
               ])
            && trialOk()
            && clTrialOk());

      allow delete: if false;
    }
  }
}
