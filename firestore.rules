rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'osiasnalaunan68@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function noFreeSubs(d) {
      return !('subscriptions' in d)
        || (d.subscriptions.get('CL', false) == false
         && d.subscriptions.get('TL', false) == false
         && d.subscriptions.get('CDP', false) == false
         && d.subscriptions.get('PC', false) == false
         && d.subscriptions.get('TCP', false) == false);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && noFreeSubs(request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('triageStatus' in request.resource.data));

      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['subscriptions', 'isAdmin', 'triageStatus']));

      allow delete: if isAdmin();
    }
  }
}
